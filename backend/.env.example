# =====================================================================
# Backend environment template.
# Copy to backend/.env and fill in real values. Never commit the real file.
#   cp backend/.env.example backend/.env
# =====================================================================

# --- Core server ---
PORT=8000
NODE_ENV=development
# "false" in dev, "true" in production
PRODUCTION=false

# --- Database ---
# Full MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# --- Frontend origin (used by CORS + email links) ---
# Development: http://localhost:3000   Production: https://tursaile.in
ORIGIN=http://localhost:3000

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-secret
LOGIN_TOKEN_EXPIRATION=30d
OTP_EXPIRATION_TIME=120000
PASSWORD_RESET_TOKEN_EXPIRATION=2m
COOKIE_EXPIRATION_DAYS=30

# --- Email ---
# EMAIL_PROVIDER=ses uses AWS SES. Any other value falls back to Gmail/SMTP
# (EMAIL + PASSWORD below).
EMAIL_PROVIDER=ses
# Default From (no-reply) for automated/agent mail.
SES_FROM_EMAIL="YourApp <noreply@yourdomain.com>"
# From used when the super admin is the sender (feedback resolved, agency welcome).
SES_ADMIN_FROM_EMAIL="YourApp Admin <admin@yourdomain.com>"
# Default Reply-To when a message sets no explicit reply address.
MAIL_REPLY_TO=support@yourdomain.com
# Super admin inbox that receives feedback submissions/reopens (must be readable).
FEEDBACK_NOTIFY_EMAIL=admin@yourdomain.com
# TEMPORARY blind copy on agent/agency mail to verify routing. Leave empty to disable.
SUPPORT_BCC_EMAIL=
# Optional custom SMTP (only when EMAIL_PROVIDER is not "ses"); else Gmail service is used.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# Gmail/SMTP credentials (only needed when EMAIL_PROVIDER is not "ses")
EMAIL=
PASSWORD=

# --- AWS (S3 file storage + SES email) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=maritime-cms-dev-upload
# Set only for LocalStack/local S3 emulation; leave empty for real AWS
AWS_ENDPOINT_URL=
AWS_USE_LOCALSTACK=false
S3_PRESIGN_EXPIRES_SECONDS=3600
S3_PRESIGN_UPLOAD_EXPIRES_SECONDS=900

# --- Image/logo processing ---
LOGO_MAX_WIDTH_PX=256
LOGO_JPEG_QUALITY=85

# --- TLS (dev only; do not enable in production) ---
NODE_TLS_REJECT_UNAUTHORIZED=0
